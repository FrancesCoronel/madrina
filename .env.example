# Slack app (from api.slack.com/apps > your app)
# SLACK_BOT_TOKEN=xoxb-... (optional: `slack run` injects SLACK_CLI_XOXB; only set this for Vercel)
SLACK_SIGNING_SECRET=your-signing-secret

# Claude (hackathon credits)
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional: override the model (default claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Local dev tunnel for `slack run` (free at dashboard.ngrok.com)
NGROK_AUTH_TOKEN=your-ngrok-token

# Cron auth (step 5). Vercel sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=any-long-random-string
